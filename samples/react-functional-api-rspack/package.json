{
  "name": "@samples/react-functional-api-rspack",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "rspack serve --config rspack.config.mjs --mode development",
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "rspack build --config rspack.config.mjs --mode production",
    "test": "cross-env NODE_ENV=unittest mocha",
    "test:hmr:e2e": "node ../../scripts/samples-hmr-e2e.mjs --sample react-functional-api-rspack"
  },
  "dependencies": {
    "@midwayjs/bootstrap": "workspace:*",
    "@midwayjs/core": "workspace:*",
    "@midwayjs/koa": "workspace:*",
    "@midwayjs/web-bridge": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@midwayjs/mock": "workspace:*",
    "@rspack/cli": "^1.5.6",
    "@rspack/core": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "cross-env": "^7.0.3",
    "mocha": "^10.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "5.6.3"
  }
}
