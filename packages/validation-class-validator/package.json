{
  "name": "@midwayjs/validation-class-validator",
  "version": "4.0.0-beta.9",
  "description": "Midway validation component based on class-validator",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "typings": "index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand",
    "cov": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand --coverage --forceExit",
    "ci": "npm run test"
  },
  "keywords": [
    "midway",
    "validation",
    "class-validator"
  ],
  "author": "",
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts",
    "index.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@midwayjs/i18n": "workspace:^",
    "@midwayjs/validation": "workspace:^",
    "class-transformer": "^0.5.1",
    "class-validator-multi-lang-lite": "^0.140.1"
  },
  "devDependencies": {
    "@midwayjs/core": "workspace:*",
    "@midwayjs/mock": "workspace:*",
    "class-validator": "^0.14.1",
    "tsup": "8.5.0"
  }
}
