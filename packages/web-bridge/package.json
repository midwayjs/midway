{
  "name": "@midwayjs/web-bridge",
  "version": "4.0.0-beta.16",
  "description": "Midway web bridge for API contract client and build transforms",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "require": "./dist/vite.js",
      "import": "./dist/vite.mjs"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "require": "./dist/rspack.js",
      "import": "./dist/rspack.mjs"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts"
  ],
  "keywords": [
    "midway",
    "web-bridge",
    "api"
  ],
  "author": "Midway Team",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "test": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand",
    "test:dist": "node test/esm-dist.test.mjs",
    "cov": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand --coverage --forceExit",
    "ci": "npm run test && npm run test:dist",
    "lint": "mwts check"
  },
  "dependencies": {
    "@midwayjs/api-bridge": "workspace:^"
  },
  "devDependencies": {
    "tsup": "8.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
