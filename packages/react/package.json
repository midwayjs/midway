    "react-dom": ">=18"
  },
  "devDependencies": {
    "@midwayjs/mock": "workspace:^",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18",
    "react-dom": "^18"
  },
  "engines": {
    "node": ">=20"
  }
}
