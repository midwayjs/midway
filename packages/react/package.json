{
  "name": "@midwayjs/react",
  "version": "4.0.0-beta.11",
  "description": "Midway React API bridge component",
  "main": "dist/index.js",
  "typings": "index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "index.d.ts"
  ],
  "keywords": [
    "midway",
