{
  "name": "@midwayjs/validation-joi",
  "version": "4.0.0",
  "description": "Midway Component for validation and use joi as validation tool",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "typings": "index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand",
    "test:dist": "node test/esm-dist.test.mjs",
    "cov": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand --coverage --forceExit",
    "ci": "npm run test"
  },
  "keywords": [],
  "author": "czy88840616@gmail.com",
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@midwayjs/i18n": "workspace:^",
    "@midwayjs/validation": "workspace:^"
  },
  "devDependencies": {
    "@midwayjs/core": "workspace:^",
    "@midwayjs/koa": "workspace:^",
    "@midwayjs/mock": "workspace:^",
    "joi": "17.13.3",
    "tsup": "8.5.0"
  }
}
