{
  "name": "@midwayjs/vue",
  "version": "4.0.0-beta.13",
  "description": "Midway Vue API bridge component",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts"
  ],
  "keywords": [
    "midway",
    "vue",
    "bridge"
  ],
  "author": "Midway Team",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "test": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand",
    "cov": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand --coverage --forceExit",
    "ci": "npm run test",
    "lint": "mwts check"
  },
  "dependencies": {
    "@midwayjs/web-bridge": "workspace:^"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "devDependencies": {
    "tsup": "8.5.0",
    "vue": "^3.5.22"
  },
  "engines": {
    "node": ">=20"
  }
}
