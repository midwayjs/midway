{
  "name": "@midwayjs/crud",
  "version": "4.2.1",
  "description": "Midway Component for declarative CRUD APIs",
  "main": "dist/index.js",
  "typings": "index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "index.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./typeorm": {
      "types": "./dist/typeorm/index.d.ts",
      "default": "./dist/typeorm/index.js"
    },
    "./sequelize": {
      "types": "./dist/sequelize/index.d.ts",
      "default": "./dist/sequelize/index.js"
    },
    "./mongoose": {
      "types": "./dist/mongoose/index.d.ts",
      "default": "./dist/mongoose/index.js"
    },
    "./mikro": {
      "types": "./dist/mikro/index.d.ts",
      "default": "./dist/mikro/index.js"
    },
    "./functional": {
      "types": "./dist/functional/index.d.ts",
      "default": "./dist/functional/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand",
    "cov": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand --coverage --forceExit",
    "ci": "npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@midwayjs/core": "workspace:^"
  },
  "devDependencies": {
    "@midwayjs/mikro": "workspace:^",
    "@midwayjs/mock": "workspace:^",
    "@midwayjs/mongoose": "workspace:^",
    "@midwayjs/sequelize": "workspace:^",
    "@midwayjs/typeorm": "workspace:^",
    "mongoose": "8.9.5",
    "sequelize": "6.37.8",
    "sequelize-typescript": "2.1.6",
    "sqlite3": "5.1.7",
    "typeorm": "1.0.0"
  }
}
