{
  "name": "@midwayjs/mikro7",
  "version": "4.2.1",
  "description": "Midway Component for MikroORM v7",
  "type": "module",
  "main": "dist/index.js",
  "typings": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "index.d.ts"
  ],
  "peerDependencies": {
    "@mikro-orm/core": "^7.0.0"
  },
  "devDependencies": {
    "@midwayjs/core": "workspace:^",
    "@midwayjs/koa": "workspace:^",
    "@midwayjs/mock": "workspace:^",
    "@mikro-orm/core": "7.0.13",
    "@mikro-orm/decorators": "7.0.13",
    "@mikro-orm/entity-generator": "7.0.13",
    "@mikro-orm/sqlite": "7.0.13"
  },
  "author": {
    "name": "czy88840616",
    "email": "czy88840616@gmail.com"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "cov": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --coverage --forceExit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/midwayjs/midway.git"
  }
}
