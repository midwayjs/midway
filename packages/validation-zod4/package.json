{
  "name": "@midwayjs/validation-zod4",
  "version": "4.0.0-beta.10",
  "description": "Midway Component for validation and use zod as validation tool",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "typings": "index.d.ts",
  "dependencies": {
    "@midwayjs/i18n": "workspace:^",
    "@midwayjs/validation": "workspace:^",
    "@semihbou/zod-i18n-map": "0.0.3",
    "i18next": "24.2.3",
    "zod-validation-error": "5.0.0"
  },
  "devDependencies": {
    "@midwayjs/core": "workspace:^",
    "tsup": "8.5.0",
    "zod": "4.2.1"
  },
  "scripts": {
    "build": "tsup",
    "test": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand",
    "cov": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand --coverage --forceExit",
    "ci": "npm run test"
  },
  "keywords": [
    "midway",
    "IoC",
    "zod",
    "validate",
    "zod4"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts",
    "index.d.ts"
  ],
  "author": "Harry Chen <czy88840616@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/midwayjs/midway.git"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
